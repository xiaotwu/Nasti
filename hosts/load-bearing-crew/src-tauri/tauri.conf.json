{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nasti",
  "version": "0.1.2-beta.2",
  "identifier": "dev.nasti.terminal.beta",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm --filter @nasti/prism-glass-ui dev",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "pnpm --filter @nasti/prism-glass-ui build",
      "cwd": "../.."
    },
    "frontendDist": "../../../packages/prism-glass-ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "娜斯提 · Nasti",
        "width": 1440,
        "height": 900,
        "minWidth": 850,
        "minHeight": 570,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../assets/authorized-media/": "authorized-media/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4NzVCODlDOTFGQjg3NEIKUldSTGgvdVJuTGgxeUFMZmc5V3lobmpIbTJoYUhWOEhzVkQwZ3MveDJ6TjJXRGJkMEFWcVdJWGcK",
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
