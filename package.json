    "check:contracts": "node scripts/verify-contracts.mjs",
    "check:visual-e2": "node scripts/check-e2-tokens.mjs",
    "check:all": "node scripts/verify-contracts.mjs && node scripts/check-e2-tokens.mjs && cargo check --workspace"
  },
